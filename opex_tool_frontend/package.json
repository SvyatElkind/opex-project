{
  "name": "opex_tool_frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@tanstack/react-query": "^5.76.1",
    "@tanstack/react-query-devtools": "^5.76.1",
    "@tanstack/react-query-persist-client": "^5.76.1",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "react": "^18.3.1",
    "react-datepicker": "^7.4.0",
    "react-datetime-picker": "^6.0.1",
    "react-dom": "^18.3.1",
    "react-scripts": "5.0.1",
    "react-select": "^5.8.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "web-vitals": "^2.1.4"
  },
  "proxy": "http://localhost:8000",
  "scripts": {
    "start": "npm run manifest:public && react-scripts start",
    "start:prod": "cross-env REACT_APP_DEV_MODE=false react-scripts start",
    "build": "npm run manifest:public && react-scripts build",
    "build:dev": "npm run manifest:public && cross-env REACT_APP_DEV_MODE=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "manifest": "node -e \"const fs=require('fs'),p='build/files';if(!fs.existsSync(p)){console.log('build/files/ not found');process.exit(0);}const files=fs.readdirSync(p).filter(f=>f!=='manifest.json'&&!fs.statSync(p+'/'+f).isDirectory());fs.writeFileSync(p+'/manifest.json',JSON.stringify({files},null,2));console.log('manifest.json generated:',files.length,'files');\"",
    "manifest:public": "node -e \"const fs=require('fs'),p='public/files';if(!fs.existsSync(p)){fs.mkdirSync(p,{recursive:true});console.log('Created public/files/');} const files=fs.readdirSync(p).filter(f=>f!=='manifest.json'&&!fs.statSync(p+'/'+f).isDirectory());fs.writeFileSync(p+'/manifest.json',JSON.stringify({files},null,2));console.log('manifest.json:',files.length,'test files');\""
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "cross-env": "^10.1.0"
  }
}
